data/real/*
!data/real/.gitkeep

# Generated data can be rebuilt with the generator script
data/synthetic/*
!data/synthetic/.gitkeep

# Outputs
outputs/
*.log
.DS_Store

# Demo form: rebuild with python scripts/make_demo.py
data/templates/demo/

