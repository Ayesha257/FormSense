# Copy this file to .env and paste your own key (get one at https://console.groq.com/keys)
GROQ_API_KEY=

# Optional model overrides. Groq retires models from time to time (Llama 4 Scout: 2026-07-17,
# Llama 3.3 70B: 2026-08-16). If you get "model_not_found", run: python scripts/groq_models.py
# GROQ_VLM_MODEL=qwen/qwen3.8-27b       # vision model for the VLM comparison
# GROQ_LLM_MODEL=qwen/qwen3.8-27b       # text model for the explanations (GROQ_TEXT_MODEL also works)
# GROQ_VLM_REASONING=none               # none = instruct mode; low/medium/high = thinking; empty = do not send
